# MongoDB
MONGO_USER=dit_admin
MONGO_PASS=changeme
MONGO_DB=dit_forms

# JWT
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=https://dit-tracker.vercel.app,http://localhost:3000,http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Sentry (optional)
SENTRY_DSN=https://your-dsn@sentry.io/project-id
ENVIRONMENT=production
GIT_SHA=unknown

# Email (SMTP) for usage alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=joyadevu@duck.com
